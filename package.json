{
  "name": "voteflow",
  "version": "9.1.0",
  "private": true,
  "description": "VoteFlow — браузерное расширение для автоматического голосования на рейтингах игровых серверов",
  "license": "MIT",
  "homepage": "https://github.com/BazZziliuS/VoteFlow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BazZziliuS/VoteFlow.git"
  },
  "bugs": {
    "url": "https://github.com/BazZziliuS/VoteFlow/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && git config blame.ignoreRevsFile .git-blame-ignore-revs || true",
    "lint": "eslint src scripts tests",
    "lint:fix": "eslint src scripts tests --fix",
    "test": "node --test \"tests/*.test.js\"",
    "test:ui": "node tests/ui/smoke.js",
    "check": "npm run lint && npm run format:check && node scripts/check-manifest.js && node scripts/changelog.js --check && node scripts/vendor.js --check && npm test",
    "changelog": "node scripts/changelog.js",
    "vendor": "node scripts/vendor.js",
    "build": "node scripts/build.js",
    "release": "node scripts/release.js",
    "sites": "node scripts/check-sites.js",
    "commitlint": "node scripts/commit-msg.js --range",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" eslint.config.js",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" eslint.config.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "idb": "8.0.4",
    "linkedom": "0.18.15",
    "prettier": "3.10.1"
  }
}
